{
  "name": "fog-train",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @fog-train/server dev\" \"pnpm --filter @fog-train/web dev\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "start": "pnpm --filter @fog-train/server start"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
